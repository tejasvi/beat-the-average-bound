import BeatAvg.Data.K9
import BeatAvg.Core.K7K
import BeatAvg.Core.Hier9
open BeatAvg.Check

/-! Generator of the kernel tables for k = 9 (untrusted: every entry that is used is checked in the kernel).

usage: lean --load-dynlib=… --run tools/k9ktool.lean OUTDIR [part]   (part: all (default), pat, idx, rows, core)
Writes into OUTDIR (namespace BeatAvg.Data.K9K):
- T9.lean: the K7Tab of the lower blocks of the certificate with 9 points (as T8.lean for k = 8), den6, d14;
- Pat.lean: per 7-pattern number (record-major order of the level-7 trees, as for k = 8): bits, the numbers of its
  seven faces, f7 = valK7 T9 and its list of top flags of the (6,7) blocks;
- Idx<k>.lean, k = 0..6: for each 6-pattern number q, the 7-patterns whose face k is q, sorted by the key of their
  other faces (in increasing face order, the first most significant, 11 bits each), as fields key * 2^18 + n (84 bits)
  after a count (12 bits); Idx6 is the index of the check with 8 points;
- Q<c>.lean, Q.lean: matrix rows of the (6,7) blocks (trees of depth 10: one block has 625 flags); R.lean: matrix
  rows of the (7,8) blocks (depth 9);
- Core.lean: the core patterns (8-patterns of the (7,8) flags whose restrictions are numbered) sorted by their tuple key
  (eight 18-bit numbers, the first most significant): key | bits | top list of (7,8) flags, as a list and as a tree of
  depth 9 (coreT); S (sorted, as keys and as tuples); the excluded 8-patterns and 9-patterns as tuples;
- k9_sizes.txt: flag counts of the (5,6), (6,7) and (7,8) blocks (for the shard generator). -/

def bitlen (n : Nat) : Nat := Nat.log2 n + 1

def packF (w : Nat) (l : List Nat) : Nat := l.foldr (fun a acc => a + 2 ^ w * acc) 0

partial def treeStr (depth : Nat) (leaf : Nat → Nat) (pfx : String) (out : IO.FS.Handle) : IO String := do
  let lvl := if depth > 6 then depth - 6 else 0
  let rec build (d i : Nat) : String :=
    if d == 0 then s!"(.leaf {leaf i})" else s!"(.node {build (d - 1) (2 * i)} {build (d - 1) (2 * i + 1)})"
  for i in [0:2 ^ (depth - lvl)] do
    out.putStrLn s!"def {pfx}{i} : KT := {build lvl i}"
  let rec top (d i : Nat) : String :=
    if d == 0 then s!"{pfx}{i}" else s!"(.node {top (d - 1) (2 * i)} {top (d - 1) (2 * i + 1)})"
  return top (depth - lvl) 0

/-- The tree of depth `d` with leaves `leaf i` (in memory). -/
def buildKT (leaf : Nat → Nat) : Nat → Nat → KT
  | 0, i => .leaf (leaf i)
  | d + 1, i => .node (buildKT leaf d (2 * i)) (buildKT leaf d (2 * i + 1))

def hdr (imports : String) : String :=
  imports ++ "\n/-! Kernel tables for the certificate with 9 points (generated by tools/k9ktool.lean; checked in the kernel, not\ntrusted). -/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace BeatAvg.Data.K9K\nopen BeatAvg.Check\n"

/-- Matrix rows of the blocks `bs` (indices `lo, …, hi - 1`) into `file`, one tree per block: of depth 9 if `deep` is
false; of depth 10 if `deep` is true (a block with at most 512 rows as `.node T (.leaf 0)` with `T` its tree of depth
9, so that `KT.get 10` reads rows 0-511 from `T` and 0 above; a larger block as a full tree of depth 10). -/
def writeRows (file pfx : String) (bs : List DBlock) (lo hi w off : Nat) (deep : Bool := false) : IO (List String) := do
  let rowLeafOf := fun (b : DBlock) (i : Nat) =>
    if i < b.flags.length then packF w ((qrowList b i).map fun v => (v + (off : Int)).toNat) else 0
  let h ← IO.FS.Handle.mk file .write
  h.putStrLn (hdr "import BeatAvg.Core.K7K\n")
  let mut names : List String := []
  for blk in [lo:hi] do
    let b := bs.getD blk dfltB
    if deep && b.flags.length > 512 then
      let e ← treeStr 10 (rowLeafOf b) s!"{pfx}{blk}_" h
      h.putStrLn s!"def {pfx}r{blk} : KT := {e}"
    else
      let e ← treeStr 9 (rowLeafOf b) s!"{pfx}{blk}_" h
      h.putStrLn (if deep then s!"def {pfx}r{blk} : KT := (.node {e} (.leaf 0))" else s!"def {pfx}r{blk} : KT := {e}")
    names := names ++ [s!"{pfx}r{blk}"]
  h.putStrLn "end BeatAvg.Data.K9K"
  h.flush
  return names

def rowWidth (bs : List DBlock) : Nat :=
  bitlen (bs.foldl (fun m b => (List.range b.flags.length).foldl (fun m i =>
    (qrowList b i).foldl (fun m v => max m v.natAbs) m) m) 0) + 2

def main (args : List String) : IO Unit := do
  let outDir := args.headD "K9K"
  let part := args.getD 1 "all"
  let doPart := fun (p : String) => part == "all" || part == p
  IO.FS.createDirAll outDir
  let lower := BeatAvg.Data.K9.lower
  let mid := BeatAvg.Data.K9.mid
  let top78 := BeatAvg.Data.K9.top
  let low := lower.filter fun b => decide (2 * b.m - b.t ≤ 6)
  let top := lower.filter fun b => b.t == 5 && b.m == 6
  let one := lower.filter fun b => b.t == 1 && b.m == 4
  let other := lower.filter fun b => !(decide (2 * b.m - b.t ≤ 6) || (b.t == 5 && b.m == 6) || (b.t == 1 && b.m == 4))
  IO.println s!"lower {lower.length}: low {low.length}, top {top.length}, one {one.length}, other {other.length}; mid {mid.length}; top78 {top78.length}"
  let qscale := BeatAvg.Data.K9.qscale
  let den6 := low.foldl (fun d b => Nat.lcm d (b.D 6 * qscale)) 60
  let ob := one.headD dfltB
  let d14 := ob.D 7
  let lvs := BeatAvg.Data.K8.levels
  -- 6-patterns, sorted; their f6 values (lower blocks of the low kind)
  let s6l := (chainList [0] (lvs.take 3)).mergeSort (· ≤ ·)
  let n6 := s6l.length
  let s6a := s6l.toArray
  let id6 : Std.HashMap Nat Nat := (List.range n6).foldl (fun m q => m.insert (s6a[q]!) q) {}
  let P7 := (chainList [0] lvs).toArray
  let n7 := P7.size
  let faces : Array (List Nat) := P7.map fun x => (List.range 7).map fun u => (id6.get? (faceBits x u)).getD 4095
  let id7 : Std.HashMap Nat Nat := (List.range n7).foldl (fun m n => m.insert (P7[n]!) n) {}
  IO.println s!"n6 {n6}, n7 {n7}, patterns with an unnumbered face: {((List.range n7).filter fun n => (faces[n]!).any (· == 4095)).length}"
  if doPart "pat" then
    let lk6 := tupList 6
    let f6l := s6l.map fun x => valNum 6 lk6 low den6 qscale x
    let w6 := bitlen (f6l.foldl (fun m v => max m v.natAbs) 0) + 2
    let off6 := 2 ^ (w6 - 1)
    let f6 := packF w6 (f6l.map fun v => (v + (off6 : Int)).toNat)
    -- top flags of the (5,6) blocks per 6-pattern number
    let mut tl : Array (List (Nat × Nat × Nat)) := Array.replicate n6 []
    for blk in [0:top.length] do
      let fl := (top.getD blk dfltB).flags
      for i in [0:fl.length] do
        let f := fl.getD i (0, 0)
        match id6.get? f.1 with
        | none => pure ()
        | some q =>
          for p in [0:6] do
            if f.2 == maskExcept 6 p then tl := tl.modify q (fun l => l ++ [(p, blk, i)])
    let topLeaf := fun q => if q < n6 then
        let l := tl.getD q []
        l.length + 4096 * packF 28 (l.map fun e => e.1 + 16 * e.2.1 + 65536 * e.2.2)
      else 0
    let wq := rowWidth top
    let offq := 2 ^ (wq - 1)
    let rowLeafOf := fun (b : DBlock) (w off : Nat) (i : Nat) =>
      if i < b.flags.length then packF w ((qrowList b i).map fun v => (v + (off : Int)).toNat) else 0
    let ft14 := packF 4 ((List.range 256).map fun key =>
      match lookupIdx ob.flags (key % 16, key / 16) with | some i => i + 1 | none => 0)
    let n14 := ob.flags.length
    let qv := (List.range n14).flatMap fun i => (List.range n14).map fun j => ob.qint i j
    let wq14 := bitlen (qv.foldl (fun m v => max m v.natAbs) 0) + 2
    let off14 := 2 ^ (wq14 - 1)
    let q14 := packF wq14 (qv.map fun v => (v + (off14 : Int)).toNat)
    let tab9 : K7Tab := ⟨n6, packF 60 s6l, w6, f6, buildKT topLeaf 11 0, wq,
      top.map (fun b => buildKT (rowLeafOf b wq offq) 9 0), ft14, n14, wq14, q14⟩
    IO.println s!"T9: n6 {n6}, w6 {w6}, wq {wq}, den6 {den6}, d14 {d14}"
    let h ← IO.FS.Handle.mk (outDir ++ "/T9.lean") .write
    h.putStrLn (hdr "import BeatAvg.Core.K7K\n")
    h.putStrLn s!"def n6 : Nat := {n6}\ndef s6 : Nat := {packF 60 s6l}\ndef w6 : Nat := {w6}\ndef f6 : Nat := {f6}"
    let topE ← treeStr 11 topLeaf "tp" h
    h.putStrLn s!"def topT : KT := {topE}"
    let mut qnames : Array String := #[]
    for blk in [0:top.length] do
      let b := top.getD blk dfltB
      let e ← treeStr 9 (rowLeafOf b wq offq) s!"q{blk}_" h
      h.putStrLn s!"def qr{blk} : KT := {e}"
      qnames := qnames.push s!"qr{blk}"
    h.putStrLn s!"def wq : Nat := {wq}"
    h.putStrLn s!"def qrows : List KT := [{", ".intercalate qnames.toList}]"
    h.putStrLn s!"def ft14 : Nat := {ft14}\ndef n14 : Nat := {n14}\ndef wq14 : Nat := {wq14}\ndef q14 : Nat := {q14}"
    h.putStrLn "def tab9 : K7Tab := ⟨n6, s6, w6, f6, topT, wq, qrows, ft14, n14, wq14, q14⟩"
    h.putStrLn s!"def den6 : Nat := {den6}\ndef d14 : Nat := {d14}"
    h.putStrLn "end BeatAvg.Data.K9K"
    h.flush
    -- f7 and the top flags of the (6,7) blocks per 7-pattern number
    let f7 : Array Int := (Array.range n7).map fun n => valK7 tab9 qscale den6 d14 (P7[n]!) (faces[n]!)
    let w7 := bitlen (f7.foldl (fun m v => max m v.natAbs) 0) + 2
    let off7 := 2 ^ (w7 - 1)
    let mut t7 : Array (List (Nat × Nat × Nat)) := Array.replicate n7 []
    for blk in [0:mid.length] do
      let fl := (mid.getD blk dfltB).flags
      for i in [0:fl.length] do
        let f := fl.getD i (0, 0)
        match id7.get? f.1 with
        | none => pure ()
        | some n =>
          for p in [0:7] do
            if f.2 == maskExcept 7 p then t7 := t7.modify n (fun l => l ++ [(p, blk, i)])
    IO.println s!"f7: w7 {w7}; top7: max {t7.foldl (fun m l => max m l.length) 0}, total {t7.foldl (fun m l => m + l.length) 0}"
    let patLeaf := fun n => if n < n7 then
        let l := t7[n]!
        P7[n]! + 2 ^ 140 * (packF 11 (faces[n]!) + 2 ^ 77 * ((f7[n]! + (off7 : Int)).toNat +
          2 ^ w7 * (l.length + 4096 * packF 28 (l.map fun e => e.1 + 16 * e.2.1 + 65536 * e.2.2))))
      else 0
    let h ← IO.FS.Handle.mk (outDir ++ "/Pat.lean") .write
    h.putStrLn (hdr "import BeatAvg.Core.K7K\n")
    h.putStrLn s!"def n7 : Nat := {n7}\ndef w7 : Nat := {w7}"
    let patE ← treeStr 18 patLeaf "pt" h
    h.putStrLn s!"def pat : KT := {patE}"
    h.putStrLn "end BeatAvg.Data.K9K"
    h.flush
    IO.println s!"wrote T9.lean, Pat.lean"
  if doPart "idx" then
    for k in [0:7] do
      let keyOf := fun (n : Nat) => (((List.range 7).filter (· != k)).map fun j => (faces[n]!).getD j 0).foldl
        (fun acc f => acc * 2048 + f) 0
      let mut ch : Array (List Nat) := Array.replicate n6 []
      for n in [0:n7] do
        let q := (faces[n]!).getD k 0
        ch := ch.modify q (fun l => n :: l)
      let maxc := ch.foldl (fun m l => max m l.length) 0
      IO.println s!"Idx{k}: largest run {maxc}"
      if maxc ≥ 4096 then
        IO.println s!"Idx{k}: run longer than 4095, the count field is too small"
        return
      let leaf := fun q => if q < n6 then
          let es := ((ch[q]!).map fun n => keyOf n * 2 ^ 18 + n).mergeSort (· ≤ ·)
          es.length + 4096 * packF 84 es
        else 0
      let h ← IO.FS.Handle.mk (outDir ++ s!"/Idx{k}.lean") .write
      h.putStrLn (hdr "import BeatAvg.Core.K7K\n")
      let e ← treeStr 11 leaf s!"ix{k}_" h
      h.putStrLn s!"def idx{k} : KT := {e}"
      h.putStrLn "end BeatAvg.Data.K9K"
      h.flush
    IO.println s!"wrote Idx0-6"
  if doPart "rows" then
    let wq8 := rowWidth mid
    let offq8 := 2 ^ (wq8 - 1)
    let nchunk := 16
    let per := (mid.length + nchunk - 1) / nchunk
    let mut qn8 : List String := []
    for c in [0:nchunk] do
      let ns ← writeRows (outDir ++ s!"/Q{c}.lean") "m" mid (c * per) (min mid.length ((c + 1) * per)) wq8 offq8 true
      qn8 := qn8 ++ ns
    let h ← IO.FS.Handle.mk (outDir ++ "/Q.lean") .write
    h.putStrLn (hdr ("".intercalate ((List.range nchunk).map fun c => s!"import BeatAvg.Data.K9K.Q{c}\n")))
    h.putStrLn s!"def wq8 : Nat := {wq8}"
    h.putStrLn s!"def mrows : List KT := [{", ".intercalate qn8}]"
    h.putStrLn "end BeatAvg.Data.K9K"
    h.flush
    let wq9 := rowWidth top78
    let offq9 := 2 ^ (wq9 - 1)
    let rn ← writeRows (outDir ++ "/R0.lean") "t" top78 0 top78.length wq9 offq9
    let h ← IO.FS.Handle.mk (outDir ++ "/R.lean") .write
    h.putStrLn (hdr "import BeatAvg.Data.K9K.R0\n")
    h.putStrLn s!"def wq9 : Nat := {wq9}"
    h.putStrLn s!"def trows : List KT := [{", ".intercalate rn}]"
    h.putStrLn "end BeatAvg.Data.K9K"
    h.flush
    IO.println s!"rows: wq8 {wq8} ({mid.length} blocks in {nchunk} files), wq9 {wq9} ({top78.length} blocks)"
  if doPart "core" then
    let idx8 := delIdx 8
    let idx9 := delIdx 9
    let tupleOf := fun (bits : Nat) => (List.range 8).map fun u => (id7.get? (gather bits (idx8.getD u []))).getD 999999
    let keyT := fun (t : List Nat) => t.foldl (fun acc a => acc * 2 ^ 18 + a) 0
    let nb8 := (tupList 8).length
    -- core patterns: 8-patterns of the (7,8) flags whose restrictions are all numbered
    let mut core : Array (Nat × List Nat) := #[]
    for blk in [0:top78.length] do
      let fl := (top78.getD blk dfltB).flags
      for i in [0:fl.length] do
        let f := fl.getD i (0, 0)
        let t := tupleOf f.1
        if !(t.any (· == 999999)) && !(core.any (fun e => e.1 == f.1)) then core := core.push (f.1, t)
    let coreL := core.toList.mergeSort (fun a b => keyT a.2 ≤ keyT b.2)
    let topOf := fun (bits : Nat) => (List.range top78.length).flatMap fun blk =>
      let fl := (top78.getD blk dfltB).flags
      (List.range fl.length).flatMap fun i =>
        let f := fl.getD i (0, 0)
        if f.1 == bits then ((List.range 8).filter fun p => f.2 == maskExcept 8 p).map fun p => (p, blk, i) else []
    let leaves := coreL.map fun e =>
      let l := topOf e.1
      keyT e.2 + 2 ^ 144 * (e.1 + 2 ^ nb8 * (l.length + 4096 * packF 28 (l.map fun x => x.1 + 16 * x.2.1 + 65536 * x.2.2)))
    let native := BeatAvg.Data.K9.core.toList.map fun e => keyT e.2.toList
    IO.println s!"core: {coreL.length} (native list {native.length}, same set: {decide (native.mergeSort (· ≤ ·) = coreL.map (fun e => keyT e.2))}); bits {nb8}; max top list {(coreL.map fun e => (topOf e.1).length).foldl max 0}"
    let sKeys := (BeatAvg.Data.K9.S.toList.map fun t => keyT t.toList).mergeSort (· ≤ ·)
    let sList := (BeatAvg.Data.K9.S.toList.map (·.toList)).mergeSort (fun a b => keyT a ≤ keyT b)
    let ex8 := BeatAvg.Data.K9.excl8.map fun e => tupleOf e.1
    let ex9 := BeatAvg.Data.K9.excl9.map fun e => (List.range 9).map fun u => tupleOf (gather e.1 (idx9.getD u []))
    let h ← IO.FS.Handle.mk (outDir ++ "/Core.lean") .write
    h.putStrLn (hdr "import BeatAvg.Core.K7K\n")
    h.putStrLn s!"def ncore : Nat := {coreL.length}"
    h.putStrLn s!"def coreL : List Nat := {leaves}"
    let la := leaves.toArray
    let e ← treeStr 9 (fun i => la.getD i 0) "cr" h
    h.putStrLn s!"def coreT : KT := {e}"
    h.putStrLn s!"def nb8 : Nat := {nb8}"
    h.putStrLn s!"def sKeys : List Nat := {sKeys}"
    h.putStrLn s!"def sList : List (List Nat) := {sList}"
    h.putStrLn s!"def excl8T : List (List Nat) := {ex8}"
    h.putStrLn s!"def excl9T : List (List (List Nat)) := {ex9}"
    h.putStrLn "end BeatAvg.Data.K9K"
    h.flush
    IO.println s!"S {sKeys.length}, excl8 {ex8.length}, excl9 {ex9.length}; wrote Core.lean"
  let sz := fun (l : List DBlock) => " ".intercalate (l.map fun b => toString b.flags.length)
  IO.FS.writeFile (outDir ++ "/k9_sizes.txt") s!"top {sz top}\nmid {sz mid}\ntop78 {sz top78}\n"
  IO.println s!"wrote {outDir}"
