/-! Assembly of the kernel check with 9 points: stages 2 and 3. -/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option Elab.async false

namespace BeatAvg.K.K9
open BeatAvg.Check

theorem all_s2 : ∀ s ∈ K9.sList, stage2 K9 b9 s = true := by
  have h : ∀ i < 26, ((K9.sList.drop (i * 10)).take 10).all (stage2 K9 b9) = true := by
    intro i hi
    interval_cases i
    · exact s2_0
    · exact s2_10
    · exact s2_20
    · exact s2_30
    · exact s2_40
    · exact s2_50
    · exact s2_60
    · exact s2_70
    · exact s2_80
    · exact s2_90
    · exact s2_100
    · exact s2_110
    · exact s2_120
    · exact s2_130
    · exact s2_140
    · exact s2_150
    · exact s2_160
    · exact s2_170
    · exact s2_180
    · exact s2_190
    · exact s2_200
    · exact s2_210
    · exact s2_220
    · exact s2_230
    · exact s2_240
    · rw [List.take_of_length_le (l := K9.sList.drop (25 * 10)) (i := 10) (by simp [sLen])]
      have h := s2_250
      rw [List.take_of_length_le (l := K9.sList.drop 250) (i := 1) (by simp [sLen])] at h
      exact h
  have hall := all_of_chunks _ K9.sList 10 26 (by simp [sLen]) h
  exact fun s hs => List.all_eq_true.1 hall s hs

