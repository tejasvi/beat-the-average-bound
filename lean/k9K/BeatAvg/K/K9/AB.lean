theorem all_idxK : ∀ k < 7, ∀ q < T.n6, idxRunK K K9.idxs k q = true := by
  intro k hk q hq
  rw [n6eq] at hq
  interval_cases k
  · exact allR_mem ic0 q (Nat.zero_le _) (by omega)
  · exact allR_mem ic1 q (Nat.zero_le _) (by omega)
  · exact allR_mem ic2 q (Nat.zero_le _) (by omega)
  · exact allR_mem ic3 q (Nat.zero_le _) (by omega)
  · exact allR_mem ic4 q (Nat.zero_le _) (by omega)
  · exact allR_mem ic5 q (Nat.zero_le _) (by omega)
  · exact allR_mem ic6 q (Nat.zero_le _) (by omega)

theorem all_cnt : ∀ k < 7, idxCountK K K9.idxs k T.n6 = true := by
  intro k hk
  rw [n6eq]
  interval_cases k
  exacts [cnt_0, cnt_1, cnt_2, cnt_3, cnt_4, cnt_5, cnt_6]

def QmOK (b : Nat) : Prop := qrowOKd 10 Tm mid b 0 (mid.getD b dfltB).flags.length = true

def FlagOK (b : Nat) : Prop := ∀ i < (mid.getD b dfltB).flags.length, flagTopOK T K mid b i = true

