  unfold QmOK
  rw [mlen_0]
  exact qrowOKd_add (lo := 0) (n := 66) (m := 330) (qrowPd_sound m_0_0) (qrowOKd_add (lo := 66) (n := 66) (m := 264) (qrowPd_sound m_0_66) (qrowOKd_add (lo := 132) (n := 66) (m := 198) (qrowPd_sound m_0_132) (qrowOKd_add (lo := 198) (n := 66) (m := 132) (qrowPd_sound m_0_198) (qrowOKd_add (lo := 264) (n := 66) (m := 66) (qrowPd_sound m_0_264) (qrowPd_sound m_0_330)))))

