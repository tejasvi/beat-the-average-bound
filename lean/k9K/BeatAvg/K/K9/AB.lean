set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option Elab.async false

namespace BeatAvg.K.K9
open BeatAvg.Check

theorem ic0_0 : allR (idxRunK K K9.idxs 0) 0 1290 = true :=
  allR_add (lo := 0) (n := 250) (m := 1040) is0_0 (allR_add (lo := 250) (n := 250) (m := 790) is0_250 (allR_add (lo := 500) (n := 250) (m := 540) is0_500 (allR_add (lo := 750) (n := 250) (m := 290) is0_750 (allR_add (lo := 1000) (n := 250) (m := 40) is0_1000 (is0_1250)))))

theorem ic0 : allR (idxRunK K K9.idxs 0) 0 1290 = true :=
  ic0_0

