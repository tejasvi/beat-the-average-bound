/-- Record `j` of the level-7 trees: valid tree, numbered leaves. -/
def RecOK (j : Nat) : Prop := treeK7OK l7 j = true ∧
  ∀ x ∈ (recAt l7 j).2.2.2, ∃ n, patOK8 T K mid qscale den6 d14 n x = true

